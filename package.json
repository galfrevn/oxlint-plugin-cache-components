{
  "name": "oxlint-plugin-cache-components",
  "version": "0.1.0",
  "description": "Oxlint rules that catch Next.js Cache Components errors before next start. Also runs in ESLint.",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "nextjs",
    "next",
    "use-cache",
    "cache-components",
    "cachelife",
    "cachetag",
    "revalidatetag",
    "server-actions"
  ],
  "homepage": "https://github.com/galfrevn/oxlint-plugin-cache-components#readme",
  "bugs": "https://github.com/galfrevn/oxlint-plugin-cache-components/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galfrevn/oxlint-plugin-cache-components.git"
  },
  "license": "MIT",
  "author": "Valentin Galfre",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./configs": {
      "types": "./dist/configs.d.ts",
      "import": "./dist/configs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "corpus": "pnpm run build && node scripts/corpus/run.mjs",
    "next-sync": "node scripts/next-sync.mjs",
    "smoke": "node scripts/smoke.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.21.0",
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "oxlint": ">=1.95.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "dependencies": {
    "@oxlint/plugins": "^1.95.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
